async function startServer() {
  const app = express();
  app.use(express.json({ limit: "6mb" }));

  // Warm up the initial Showcase MP4 Clip in background
  ensureShowcaseClips().catch((err) => {
    console.error("Showcase warmup error:", err);
  });

  // Dedicated video streamer supporting full HTTP 206 Partial Content, HEAD, and robust 416 handling
  const streamVideoFile = (
    req: express.Request,
    res: express.Response,
    isHeadOnly = false
  ) => {
    const safeName = path.basename(String(req.params.filename || ""));
    const isMp4 = safeName.endsWith(".mp4");
    const isJpg = safeName.endsWith(".jpg") || safeName.endsWith(".jpeg");
    if (!isMp4 && !isJpg) {
      res.status(400).json({ error: "Invalid filename." });
      return;
    }
    const filePath = path.join(CLIPS_DIR, safeName);
    if (!fs.existsSync(filePath)) {
      res.status(404).json({ error: "ဖိုင် မတွေ့ရှိပါ။" });
      return;
    }

    if (isJpg) {
      res.setHeader("Content-Type", "image/jpeg");
      res.setHeader("Cache-Control", "public, max-age=86400");
      if (isHeadOnly) {
        res.end();
        return;
      }
      fs.createReadStream(filePath).pipe(res);
      return;
    }

    let fileSize = 0;
    try {
      const stat = fs.statSync(filePath);
      fileSize = stat.size;
    } catch {
      res.status(404).json({ error: "ဗီဒီယိုဖိုင် ဖတ်၍မရပါ။" });
      return;
    }

    if (fileSize === 0) {
      res.status(404).json({ error: "ဗီဒီယိုဖိုင် ပြင်ဆင်နေဆဲဖြစ်ပါသည်။" });
      return;
    }

    res.setHeader("Accept-Ranges", "bytes");
    res.setHeader("Content-Type", "video/mp4");
    res.setHeader("Cache-Control", "public, max-age=3600");

    if (req.query.download === "1") {
      res.setHeader("Content-Disposition", `attachment; filename="${safeName}"`);
    }

    const rangeHeader = req.headers.range;

    // Standard non-range GET / HEAD request
    if (!rangeHeader) {
      res.setHeader("Content-Length", fileSize);
      res.status(200);
      if (isHeadOnly) {
        res.end();
        return;
      }
      const stream = fs.createReadStream(filePath);
      stream.on("error", (err) => {
        console.error("Stream error on full file:", err);
        if (!res.headersSent) res.status(500).end();
        else res.end();
      });
      stream.pipe(res);
      return;
    }

    // Parse Range header e.g. "bytes=0-1024" or "bytes=1024-" or "bytes=-512"
    const match = /^bytes=(\d*)-(\d*)$/.exec(rangeHeader.trim());
    if (!match) {
      // Malformed range: return clean 416 without throwing an unhandled exception
      res.status(416);
      res.setHeader("Content-Range", `bytes */${fileSize}`);
      res.end();
      return;
    }

    let start: number;
    let end: number;

    if (match[1] === "" && match[2] !== "") {
      // Suffix range: bytes=-500 (last 500 bytes)
      const suffixLength = parseInt(match[2], 10);
      if (isNaN(suffixLength) || suffixLength <= 0) {
        res.status(416).setHeader("Content-Range", `bytes */${fileSize}`).end();
        return;
      }
      start = Math.max(0, fileSize - suffixLength);
      end = fileSize - 1;
    } else if (match[1] !== "" && match[2] === "") {
      // Range to EOF: bytes=1000-
      start = parseInt(match[1], 10);
      end = fileSize - 1;
    } else if (match[1] !== "" && match[2] !== "") {
      // Closed range: bytes=100-200
      start = parseInt(match[1], 10);
      end = parseInt(match[2], 10);
    } else {
      res.status(416).setHeader("Content-Range", `bytes */${fileSize}`).end();
      return;
    }

    // Check satisfiability: out-of-range, NaN, or inverted
    if (isNaN(start) || isNaN(end) || start < 0 || start >= fileSize || end < start) {
      res.status(416);
      res.setHeader("Content-Range", `bytes */${fileSize}`);
      res.end();
      return;
    }

    // Clamp end
    const safeEnd = Math.min(end, fileSize - 1);
    const chunkSize = safeEnd - start + 1;

    res.status(206);
    res.setHeader("Content-Range", `bytes ${start}-${safeEnd}/${fileSize}`);
    res.setHeader("Content-Length", chunkSize);

    if (isHeadOnly) {
      res.end();
      return;
    }

    const stream = fs.createReadStream(filePath, { start, end: safeEnd });
    stream.on("error", (err) => {
      console.error("Stream error on partial file:", err);
      if (!res.headersSent) res.status(500).end();
      else res.end();
    });
    stream.pipe(res);
  };

  app.get("/api/clips/:filename", (req, res) => {
    streamVideoFile(req, res, false);
  });

  app.head("/api/clips/:filename", (req, res) => {
