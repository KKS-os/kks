async function probeMediaFile(filePath: string): Promise<{ durationSec: number; hasAudio: boolean } | null> {
  try {
    const args = ["-v", "error"];
    if (filePath.startsWith("http://") || filePath.startsWith("https://")) {
      args.push(
        "-user_agent",
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "-reconnect",
        "1",
        "-reconnect_streamed",
        "1",
        "-reconnect_delay_max",
        "5"
      );
    }
    args.push(
      "-show_entries",
      "format=duration:stream=codec_type,duration",
      "-of",
      "json",
      filePath
    );
    const { stdout } = await execFileAsync("ffprobe", args, { timeout: 10000 });
    const parsed = JSON.parse(stdout);
    const streams = Array.isArray(parsed?.streams) ? parsed.streams : [];
    const hasVideo = streams.some((s: { codec_type?: string }) => s.codec_type === "video");
    const hasAudio = streams.some((s: { codec_type?: string }) => s.codec_type === "audio");
    if (!hasVideo) return null;

    let duration = Number(parsed?.format?.duration || 0);
    if (!Number.isFinite(duration) || duration <= 0) {
      const streamDur = Number(streams.find((s: { duration?: string }) => s.duration)?.duration || 0);
      duration = streamDur > 0 ? streamDur : 120; // Default sensible fallback duration
    }
    return { durationSec: duration, hasAudio };
  } catch {
    return null;
  }
}

async function createGoldCyberBackdrop(jobDir: string, index: number): Promise<string> {
  const generatedPath = path.join(jobDir, `gold_backdrop_${index}.jpg`);
  if (!fs.existsSync(generatedPath)) {
    // Generate a luxury dark cyber gradient frame matching the KKS Gold OS theme
    const colors = ["0x0A0803", "0x120E05", "0x0E0B04"];
    const c = colors[index % colors.length];
    await execFileAsync("ffmpeg", [
      "-y",
      "-f",
      "lavfi",
      "-i",
      `color=c=${c}:s=720x1280:d=1`,
      "-frames:v",
      "1",
      generatedPath,
    ]);
  }
  return generatedPath;
}

async function extractSourceMedia(rawUrl: string, jobDir: string): Promise<SourceMediaInfo> {
  const normalizedUrl = normalizeUserUrl(rawUrl);
  const platform = detectPlatform(normalizedUrl);
  const youtubeId = extractYouTubeId(normalizedUrl);

  let title = "";
  let author = "";
  let description = "";
  const framePaths: string[] = [];

  // Metadata & Thumbnail Discovery
  if (youtubeId) {
    try {
      const oembedRes = await fetchBufferWithTimeout(
        `https://www.youtube.com/oembed?url=${encodeURIComponent(`https://www.youtube.com/watch?v=${youtubeId}`)}&format=json`,
        4500,
        256 * 1024
      );
      if (oembedRes) {
        const json = JSON.parse(oembedRes.buffer.toString("utf-8"));
        title = json.title || "";
        author = json.author_name || "";
      }
    } catch {
      // Ignore oembed error
    }

    const thumbUrls = [
      `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`,
      `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`,
      `https://i.ytimg.com/vi/${youtubeId}/1.jpg`,
      `https://i.ytimg.com/vi/${youtubeId}/2.jpg`,
    ];

    const thumbResults = await Promise.all(
      thumbUrls.map((u) => fetchBufferWithTimeout(u, 4000, 4 * 1024 * 1024))
    );
    thumbResults.forEach((res, idx) => {
      if (res && res.buffer.byteLength > 3500 && res.contentType.includes("image")) {
        const p = path.join(jobDir, `thumb_${idx}.jpg`);
        fs.writeFileSync(p, res.buffer);
        framePaths.push(p);
      }
    });
  } else if (platform !== "Direct_Video") {
    const htmlRes = await fetchBufferWithTimeout(normalizedUrl, 5000, 1024 * 1024);
    if (htmlRes && htmlRes.contentType.includes("text/html")) {
      const html = htmlRes.buffer.toString("utf-8");
      const ogTitle =
        html.match(/<meta[^>]+property=["']og:title["'][^>]+content=["']([^"']+)["']/i)?.[1] ||
        html.match(/<meta[^>]+content=["']([^"']+)["'][^>]+property=["']og:title["']/i)?.[1] ||
        html.match(/<title[^>]*>([^<]+)<\/title>/i)?.[1];
      const ogDesc =
        html.match(/<meta[^>]+property=["']og:description["'][^>]+content=["']([^"']+)["']/i)?.[1] ||
        html.match(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']+)["']/i)?.[1];
      const ogImg =
        html.match(/<meta[^>]+property=["']og:image["'][^>]+content=["']([^"']+)["']/i)?.[1] ||
        html.match(/<meta[^>]+content=["']([^"']+)["'][^>]+property=["']og:image["']/i)?.[1];

      if (ogTitle) title = decodeHtmlEntities(ogTitle);
      if (ogDesc) description = decodeHtmlEntities(ogDesc);

      if (ogImg) {
        const cleanImgUrl = decodeHtmlEntities(ogImg);
        const imgData = await fetchBufferWithTimeout(cleanImgUrl, 4500, 5 * 1024 * 1024);
        if (imgData && imgData.buffer.byteLength > 3000) {
          const p = path.join(jobDir, "og_thumb.jpg");
          fs.writeFileSync(p, imgData.buffer);
          framePaths.push(p);
        }
      }
    }
  }

  // Attempt Direct or yt-dlp Video Stream Acquisition
  let sourceVideoPath: string | null = null;
  let videoDurationSec: number | null = null;
  let hasAudio = false;

  const candidateSourcePath = path.join(jobDir, "source.mp4");

  if (platform === "Direct_Video") {
    // 1. Check if direct URL can be streamed directly
    const probedUrl = await probeMediaFile(normalizedUrl);
    if (probedUrl) {
      sourceVideoPath = normalizedUrl;
      videoDurationSec = probedUrl.durationSec;
      hasAudio = probedUrl.hasAudio;
    } else {
      // 2. Buffer download fallback
      const mediaRes = await fetchBufferWithTimeout(normalizedUrl, 6000, 30 * 1024 * 1024);
      if (mediaRes && mediaRes.buffer.byteLength > 15000) {
        fs.writeFileSync(candidateSourcePath, mediaRes.buffer);
        const probed = await probeMediaFile(candidateSourcePath);
        if (probed) {
          sourceVideoPath = candidateSourcePath;
          videoDurationSec = probed.durationSec;
          hasAudio = probed.hasAudio;
        }
      }
    }
  } else {
    const ytDlpBin = await ensureYtDlpBinary();
    if (ytDlpBin) {
      const nodeJsRuntime = `node:${process.execPath}`;
      let extractedInfo: any = null;

      // 1. Fast metadata & stream extraction using yt-dlp with node JS runtime
      try {
        const { stdout } = await execFileAsync(
          ytDlpBin,
          [
            "--no-playlist",
            "--no-warnings",
            "--socket-timeout",
            "8",
            "--js-runtimes",
            nodeJsRuntime,
            "-f",
            "b/best[height<=720][ext=mp4]/best[height<=720]/best",
            "--dump-json",
            normalizedUrl,
          ],
          { timeout: 14000, maxBuffer: 10 * 1024 * 1024 }
        );
        if (stdout && stdout.trim()) {
          extractedInfo = JSON.parse(stdout.trim());
          if (extractedInfo?.title) title = String(extractedInfo.title);
          if (extractedInfo?.uploader) author = String(extractedInfo.uploader);
          if (extractedInfo?.description) description = String(extractedInfo.description).slice(0, 500);
          if (extractedInfo?.duration && Number(extractedInfo.duration) > 0) {
            videoDurationSec = Number(extractedInfo.duration);
          }
        }
      } catch (dumpErr) {
        console.warn("yt-dlp dump-json extraction warning:", dumpErr);
      }

      // 2. Check if extracted direct stream URL can be streamed directly via ffmpeg
      if (extractedInfo?.url && String(extractedInfo.url).startsWith("http")) {
        const directUrl = String(extractedInfo.url);
        const probed = await probeMediaFile(directUrl);
        if (probed) {
          sourceVideoPath = directUrl;
          videoDurationSec = probed.durationSec;
          hasAudio = probed.hasAudio;
        }
      }

      // 3. If direct stream URL was not probed, download the first 45s of the actual video directly
      if (!sourceVideoPath) {
        try {
          await execFileAsync(
            ytDlpBin,
            [
              "--no-playlist",
              "--no-warnings",
              "--socket-timeout",
              "8",
              "--js-runtimes",
              nodeJsRuntime,
              "-f",
              "b/best[height<=720][ext=mp4]/best[height<=720]/best",
              "--download-sections",
              "*0-45",
              "--force-keyframes-at-cuts",
              "-o",
              candidateSourcePath,
              normalizedUrl,
            ],
            { timeout: 25000 }
          );
          if (fs.existsSync(candidateSourcePath) && fs.statSync(candidateSourcePath).size > 15000) {
            const probed = await probeMediaFile(candidateSourcePath);
            if (probed) {
              sourceVideoPath = candidateSourcePath;
              videoDurationSec = probed.durationSec;
              hasAudio = probed.hasAudio;
            }
          }
        } catch (sectionErr) {
          console.warn("yt-dlp section download warning:", sectionErr);
        }
      }

      // 4. Fallback whole video download (up to 35MB)
      if (!sourceVideoPath) {
        try {
          await execFileAsync(
            ytDlpBin,
            [
              "--no-playlist",
              "--no-warnings",
              "--socket-timeout",
              "8",
              "--js-runtimes",
              nodeJsRuntime,
              "-f",
              "b/best[height<=720][ext=mp4]/best[height<=720]/best",
              "--max-filesize",
              "35M",
              "-o",
              candidateSourcePath,
              normalizedUrl,
            ],
            { timeout: 25000 }
          );
          if (fs.existsSync(candidateSourcePath) && fs.statSync(candidateSourcePath).size > 15000) {
            const probed = await probeMediaFile(candidateSourcePath);
            if (probed) {
              sourceVideoPath = candidateSourcePath;
              videoDurationSec = probed.durationSec;
              hasAudio = probed.hasAudio;
            }
          }
        } catch (dlErr) {
          console.warn("yt-dlp direct download warning:", dlErr);
        }
      }
    }
  }

  // Ensure sourceVideoPath is ALWAYS a valid moving video stream or file - NEVER NULL!
  if (!sourceVideoPath) {
    sourceVideoPath = await ensureCinematicBaseVideo();
    const probedBase = await probeMediaFile(sourceVideoPath);
    videoDurationSec = probedBase?.durationSec || 30;
    hasAudio = probedBase?.hasAudio ?? true;
  }

  while (framePaths.length < 3) {
    framePaths.push(await createGoldCyberBackdrop(jobDir, framePaths.length));
  }

  return {
    normalizedUrl,
    platform,
    youtubeId,
    title: title || `ရုပ်သံဗီဒီယို အထူးကဏ္ဍ`,
    author,
    description,
    sourceVideoPath,
    videoDurationSec,
    hasAudio,
    framePaths,
  };
}

function isMyanmarCombiningMark(code: number): boolean {
  return (
    (code >= 0x102b && code <= 0x103e) ||
    (code >= 0x1056 && code <= 0x1059) ||
    (code >= 0x105e && code <= 0x1060) ||
    (code >= 0x1071 && code <= 0x108d) ||
    code === 0x108f ||
    (code >= 0x109a && code <= 0x109d)
  );
}

function countVisibleBaseUnits(str: string): number {
  let count = 0;
  for (const ch of str) {
    const code = ch.codePointAt(0) || 0;
    if (!isMyanmarCombiningMark(code)) {
      count += 1;
    }
  }
  return count;
}

function wrapBurmeseSubtitleLine(rawText: string, maxUnitsPerLine: number): string {
  const cleaned = rawText
    .replace(/[\r\n]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  // If already contains ASS tags or within limit, return with clean spacing
  const visibleOnly = cleaned.replace(/\{[^}]+\}/g, "");
  if (countVisibleBaseUnits(visibleOnly) <= maxUnitsPerLine) {
    return cleaned;
  }

  const segments = cleaned
    .replace(/([၊။])/g, "$1 ")
    .split(" ")
    .filter(Boolean);

  if (segments.length > 1) {
    const lines: string[] = [];
    let current = "";
    for (const seg of segments) {
      const candidate = current ? `${current} ${seg}` : seg;
      if (current && countVisibleBaseUnits(candidate) > maxUnitsPerLine) {
        lines.push(current);
        current = seg;
      } else {
        current = candidate;
      }
    }
    if (current) lines.push(current);
    return lines.slice(0, 2).join("\\N");
  }

  let units = 0;
  let splitIdx = -1;
  const chars = Array.from(cleaned);
  const targetMid = Math.min(maxUnitsPerLine, Math.ceil(countVisibleBaseUnits(cleaned) / 2));

  for (let i = 0; i < chars.length; i++) {
    const code = chars[i].codePointAt(0) || 0;
    if (!isMyanmarCombiningMark(code)) {
      units += 1;
    }
    if (units >= targetMid && i + 1 < chars.length) {
      const nextCode = chars[i + 1].codePointAt(0) || 0;
      const prevIsVirama = code === 0x1039 || code === 0x103a;
      if (!isMyanmarCombiningMark(nextCode) && !prevIsVirama) {
        splitIdx = i + 1;
        break;
      }
    }
  }

  if (splitIdx > 0 && splitIdx < chars.length) {
    return `${chars.slice(0, splitIdx).join("")}\\N${chars.slice(splitIdx).join("")}`;
  }
  return cleaned;
}

function formatAssTimestamp(seconds: number): string {
  const clamped = Math.max(0, seconds);
  const hrs = Math.floor(clamped / 3600);
  const mins = Math.floor((clamped % 3600) / 60);
  const secs = Math.floor(clamped % 60);
  const cs = Math.floor(Math.round((clamped - Math.floor(clamped)) * 100));
  const safeCs = Math.min(99, cs);
  return `${hrs}:${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}.${String(safeCs).padStart(2, "0")}`;
}

function writeBurmeseAssFile(
  assPath: string,
  subtitles: SubtitleCue[],
  aspectRatio: "9:16" | "16:9" | "1:1",
  clipTitleBurmese: string,
  styleOptions?: SubtitleStyleOptions
): void {
  const isVertical = aspectRatio === "9:16";
  const isSquare = aspectRatio === "1:1";
  const playResX = isVertical ? 720 : isSquare ? 1080 : 1280;
  const playResY = isVertical ? 1280 : isSquare ? 1080 : 720;

  const theme = styleOptions?.theme || "gold";
  const fontSizeChoice = styleOptions?.fontSize || "md";
  const positionChoice = styleOptions?.position || "bottom";

  let baseFontSize = isVertical ? 38 : 34;
  if (fontSizeChoice === "sm") baseFontSize = isVertical ? 32 : 28;
  if (fontSizeChoice === "lg") baseFontSize = isVertical ? 44 : 40;

  // Primary color in &HAABBGGRR
  let primaryColour = "&H0003B7FF"; // Cyber Gold #FFB703
  let outlineColour = "&H0005080C"; // Deep charcoal
  if (theme === "white_gold") {
    primaryColour = "&H00FFFFFF";
    outlineColour = "&H000088CC"; // Gold outline
  } else if (theme === "neon_amber") {
    primaryColour = "&H0024BFFB"; // Amber Neon #FBBF24
    outlineColour = "&H00020408";
  }

  let alignment = 2; // Bottom Center
  let marginV = isVertical ? 140 : 70;
  if (positionChoice === "center") {
    alignment = 5; // Middle Center
    marginV = 20;
  } else if (positionChoice === "top") {
    alignment = 8; // Top Center
    marginV = isVertical ? 140 : 70;
  }

  const maxUnits = isVertical ? 24 : 38;
  const headerTitle = wrapBurmeseSubtitleLine(clipTitleBurmese, isVertical ? 26 : 42);
  const totalEnd = subtitles.length > 0 ? Math.max(...subtitles.map((s) => s.endOffset), 10) : 12;

  const lines: string[] = [
    "[Script Info]",
    "ScriptType: v4.00+",
    `PlayResX: ${playResX}`,
    `PlayResY: ${playResY}`,
    "WrapStyle: 2",
    "ScaledBorderAndShadow: yes",
    "",
    "[V4+ Styles]",
    "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
    `Style: KKSGoldSub,Noto Sans Myanmar,${baseFontSize},${primaryColour},&H00FFFFFF,${outlineColour},&HAA000000,-1,0,0,0,100,100,0.5,0,1,4.2,2.2,${alignment},40,40,${marginV},1`,
    `Style: KKSTopKicker,Noto Sans Myanmar,${isVertical ? 22 : 20},&H2594E6FC,&H00FFFFFF,&H0008080A,&H90000000,-1,0,0,0,100,100,0.6,0,1,3.0,1.5,8,40,40,${isVertical ? 65 : 34},1`,
    "",
    "[Events]",
    "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    `Dialogue: 0,0:00:00.00,${formatAssTimestamp(totalEnd)},KKSTopKicker,,0,0,0,,{\\fad(200,200)}${headerTitle}`,
  ];

  for (const cue of subtitles) {
    const startStr = formatAssTimestamp(cue.startOffset);
    const endStr = formatAssTimestamp(cue.endOffset);
    const wrapped = wrapBurmeseSubtitleLine(cue.text, maxUnits);
    lines.push(`Dialogue: 1,${startStr},${endStr},KKSGoldSub,,0,0,0,,{\\fad(130,120)}${wrapped}`);
  }

  fs.writeFileSync(assPath, lines.join("\n"), "utf-8");
}

async function analyzeVideoWithGemini(
  media: SourceMediaInfo,
  clipDurationTarget = 12
): Promise<GeneratedClipSpec[]> {
  if (!process.env.GEMINI_API_KEY || process.env.GEMINI_API_KEY === "MY_GEMINI_API_KEY") {
    return buildFallbackClipSpecs(media, clipDurationTarget);
  }

  const ai = getGenAIClient();
  const maxDurationHint = media.videoDurationSec
    ? `Source video total duration is ${Math.floor(media.videoDurationSec)} seconds. Choose startSec safely within [0, ${Math.max(0, Math.floor(media.videoDurationSec - clipDurationTarget - 1))}].`
    : `Choose realistic startSec timestamps (e.g. 10 and 45).`;

  const promptText = `You are KKSRecap AI, a master cinematic movie-review creator and viral video recap producer (ရုပ်ရှင်သုံးသပ်ချက်နှင့် အနှစ်ချုပ် ပြန်လည်တင်ဆက်သူ ကျွမ်းကျင်သူ).
Analyze this video source and generate 2 high-impact cinematic movie-review recap clips (durationSec = ${clipDurationTarget}) with accurate Burmese subtitles and matching suspenseful Burmese movie-review narration (ရုပ်ရှင်သုံးသပ်ချက် အသံထွက် ဇာတ်ကြောင်းပြော).

Video URL: ${media.normalizedUrl}
Title: ${media.title}
Author/Channel: ${media.author || "Unknown"}
Description: ${media.description || "N/A"}
${maxDurationHint}

CRITICAL RULES FOR CINEMATIC MOVIE REVIEW:
1. Cinematic Movie Review Narration (ရုပ်ရှင်ဆန်ဆန် သုံးသပ်ချက်): Craft narration in the style of a suspenseful, gripping movie reviewer (e.g. 'ဒီဇာတ်ကားထဲမှာတော့ ဇာတ်ကောင်ဟာ...', 'မထင်မှတ်ထားတဲ့ အလှည့်အပြောင်းမှာ...', 'သူတို့ မဖြစ်မနေ ရင်ဆိုင်ရတော့မယ့် အန္တရာယ်ကတော့...').
2. Accurate Dialogue & Scene Context: Faithfully translate and capture the actual spoken dialogue, actions, and key emotions in 100% natural, correct Myanmar Unicode.
3. Subtitle Timing Cadence: Provide exactly 4 timed subtitle cues for each clip spanning from 0.0s to ${clipDurationTarget}.0s matching the voiceover cadence.
4. Mobile Readability: Keep each subtitle line concise (12 to 32 Burmese characters) with zero spelling errors.`;

  const clipSchema = {
    type: Type.ARRAY,
    items: {
      type: Type.OBJECT,
      properties: {
        clipTitleBurmese: { type: Type.STRING },
        clipSummaryBurmese: { type: Type.STRING },
        startSec: { type: Type.NUMBER },
        durationSec: { type: Type.NUMBER },
        narrationBurmese: { type: Type.STRING },
        subtitles: {
          type: Type.ARRAY,
          items: {
            type: Type.OBJECT,
            properties: {
              startOffset: { type: Type.NUMBER },
              endOffset: { type: Type.NUMBER },
              text: { type: Type.STRING },
            },
            required: ["startOffset", "endOffset", "text"],
          },
        },
      },
      required: [
        "clipTitleBurmese",
        "clipSummaryBurmese",
        "startSec",
        "durationSec",
        "narrationBurmese",
        "subtitles",
      ],
    },
  };

  // Multi-tier fast Gemini Movie Review Blueprint generator (gemini-3.1-flash-lite -> gemini-flash-latest -> fallback)
  const candidateModels = ["gemini-3.1-flash-lite", "gemini-flash-latest"];
  for (const modelName of candidateModels) {
    try {
      const parts: Array<{ text: string } | { inlineData: { mimeType: string; data: string } }> = [];
      const primaryThumb = media.framePaths[0];
      if (primaryThumb && fs.existsSync(primaryThumb)) {
        const imgBytes = fs.readFileSync(primaryThumb);
        if (imgBytes.byteLength < 2 * 1024 * 1024) {
          parts.push({
            inlineData: {
              mimeType: "image/jpeg",
              data: imgBytes.toString("base64"),
            },
          });
        }
      }
      parts.push({ text: promptText });

      const response = await Promise.race([
        ai.models.generateContent({
          model: modelName,
          contents: { parts },
          config: {
            responseMimeType: "application/json",
            responseSchema: clipSchema,
            temperature: 0.65,
          },
        }),
        new Promise<never>((_, reject) => setTimeout(() => reject(new Error("AI Analysis Timeout")), 5000)),
      ]);

      if (response.text) {
        const parsed = JSON.parse(response.text.trim()) as GeneratedClipSpec[];
        if (Array.isArray(parsed) && parsed.length > 0) {
          return sanitizeClipSpecs(parsed, media.videoDurationSec, clipDurationTarget);
        }
      }
    } catch {
      // Try next model or proceed to cinematic template fallback
    }
  }

  return buildFallbackClipSpecs(media, clipDurationTarget);
}

function sanitizeClipSpecs(
  specs: GeneratedClipSpec[],
  sourceDuration: number | null,
  targetDuration: number
): GeneratedClipSpec[] {
  return specs.slice(0, 3).map((clip, idx) => {
    const durationSec = targetDuration;
    let startSec = Number.isFinite(clip.startSec) && clip.startSec >= 0 ? clip.startSec : idx * (targetDuration + 2);
    if (sourceDuration && sourceDuration > 3) {
      const maxStart = Math.max(0, sourceDuration - durationSec);
      if (startSec > maxStart) {
        startSec = idx === 0 ? 0 : Math.max(0, maxStart * 0.5);
      }
    }

    const rawSubs = Array.isArray(clip.subtitles) && clip.subtitles.length > 0 ? clip.subtitles : [];
    const normalizedSubs: SubtitleCue[] =
      rawSubs.length > 0
        ? rawSubs.map((s, sIdx) => {
            const slot = durationSec / rawSubs.length;
            const startOffset =
              Number.isFinite(s.startOffset) && s.startOffset >= 0 && s.startOffset < durationSec
                ? s.startOffset
                : Number((sIdx * slot).toFixed(2));
            const endOffset =
              Number.isFinite(s.endOffset) && s.endOffset > startOffset && s.endOffset <= durationSec + 0.5
                ? Math.min(durationSec, s.endOffset)
                : Number(Math.min(durationSec, (sIdx + 1) * slot).toFixed(2));
            return {
              startOffset,
              endOffset,
              text: String(s.text || "").trim() || "အဓိက အပိုင်းကို ဆက်လက် ကြည့်ရှုပါ",
            };
          })
        : [
            { startOffset: 0, endOffset: Math.round(durationSec * 0.25), text: "ရုပ်သံထဲက အဓိက စိတ်ဝင်စားဖွယ် အစပျိုးချက်" },
            { startOffset: Math.round(durationSec * 0.25), endOffset: Math.round(durationSec * 0.5), text: "မထင်မှတ်ထားသော အလှည့်အပြောင်း စတင်လာခြင်း" },
            { startOffset: Math.round(durationSec * 0.5), endOffset: Math.round(durationSec * 0.75), text: "အရေးကြီးဆုံး အမှန်တရားကို ရှင်းလင်းစွာ တွေ့မြင်ရပုံ" },
            { startOffset: Math.round(durationSec * 0.75), endOffset: durationSec, text: "ပရိသတ် သဘောကျမည့် ထိရောက်သော အဆုံးသတ်" },
          ];

    return {
      clipTitleBurmese: clip.clipTitleBurmese?.trim() || `Viral ရုပ်ရှင် အပိုင်းတို (${idx + 1})`,
      clipSummaryBurmese:
        clip.clipSummaryBurmese?.trim() || "မူရင်း ရုပ်သံအနှစ်ချုပ် အကောင်းဆုံး ဖြတ်ထုတ်ထားသော အပိုင်း",
      startSec,
      durationSec,
      narrationBurmese:
        clip.narrationBurmese?.trim() || normalizedSubs.map((s) => s.text).join(" "),
      subtitles: normalizedSubs,
    };
  });
}

