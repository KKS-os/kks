function wrapPcmWithWavHeader(
  pcmBuffer: Buffer,
  sampleRate = 24000,
  numChannels = 1,
  bitsPerSample = 16
): Buffer {
  if (pcmBuffer.length >= 12 && pcmBuffer.toString("utf-8", 0, 4) === "RIFF") {
    return pcmBuffer; // Already valid WAV
  }
  const byteRate = (sampleRate * numChannels * bitsPerSample) / 8;
  const blockAlign = (numChannels * bitsPerSample) / 8;
  const dataSize = pcmBuffer.length;
  const header = Buffer.alloc(44);

  header.write("RIFF", 0);
  header.writeUInt32LE(36 + dataSize, 4);
  header.write("WAVE", 8);
  header.write("fmt ", 12);
  header.writeUInt32LE(16, 16);
  header.writeUInt16LE(1, 20); // PCM format
  header.writeUInt16LE(numChannels, 22);
  header.writeUInt32LE(sampleRate, 24);
  header.writeUInt32LE(byteRate, 28);
  header.writeUInt16LE(blockAlign, 32);
  header.writeUInt16LE(bitsPerSample, 34);
  header.write("data", 36);
  header.writeUInt32LE(dataSize, 40);

  return Buffer.concat([header, pcmBuffer]);
}

async function generateNarrationWav(narrationText: string, outWavPath: string): Promise<boolean> {
  if (!process.env.GEMINI_API_KEY || process.env.GEMINI_API_KEY === "MY_GEMINI_API_KEY") {
    return false;
  }
  try {
    const ai = getGenAIClient();
    const response = await Promise.race([
      ai.models.generateContent({
        model: "gemini-3.8-flash-lite-tts",
        contents: [
          {
            role: "user",
            parts: [{ text: narrationText }],
          },
        ],
        config: {
          responseModalities: ["AUDIO"],
          speechConfig: {
            voiceConfig: {
              prebuiltVoiceConfig: { voiceName: "Kore" },
            },
          },
        },
      }),
      new Promise<never>((_, reject) => setTimeout(() => reject(new Error("TTS timeout")), 8000)),
    ]);

    const base64Audio = response.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;
    if (base64Audio) {
      const rawBuffer = Buffer.from(base64Audio, "base64");
      if (rawBuffer.byteLength > 200) {
        const wavBuffer = wrapPcmWithWavHeader(rawBuffer);
        fs.writeFileSync(outWavPath, wavBuffer);
        return true;
      }
    }
  } catch {
    // Graceful fallback
  }
  return false;
}

export async function renderClipToMp4(options: {
  clipSpec: GeneratedClipSpec;
  clipIndex: number;
  media: SourceMediaInfo;
  aspectRatio: "9:16" | "16:9" | "1:1";
  audioMode: "original" | "voiceover" | "mix";
  framingMode?: "blur_bg" | "crop_fill" | "letterbox";
  styleOptions?: SubtitleStyleOptions;
  jobDir: string;
  outputFilename: string;
}): Promise<RenderedClipResult> {
  const {
    clipSpec,
    clipIndex,
    media,
    aspectRatio,
    audioMode,
    framingMode = "blur_bg",
    styleOptions,
    jobDir,
    outputFilename,
  } = options;

  let W = 720;
  let H = 1280;
  if (aspectRatio === "16:9") {
    W = 1280;
    H = 720;
  } else if (aspectRatio === "1:1") {
    W = 1080;
    H = 1080;
  }

  const actualClipDur =
    media.sourceVideoPath && media.videoDurationSec
      ? Math.max(4, Math.min(clipSpec.durationSec, media.videoDurationSec))
      : clipSpec.durationSec;

  const adjustedSubtitles = clipSpec.subtitles.map((cue, idx, arr) => {
    if (actualClipDur < clipSpec.durationSec) {
      const ratio = actualClipDur / clipSpec.durationSec;
      return {
        startOffset: Number((cue.startOffset * ratio).toFixed(2)),
        endOffset: Number((Math.min(actualClipDur, cue.endOffset * ratio)).toFixed(2)),
        text: cue.text,
      };
    }
    if (idx === arr.length - 1) {
      return { ...cue, endOffset: Math.min(actualClipDur, cue.endOffset) };
    }
    return cue;
  });

  const assPath = path.join(jobDir, `sub_${clipIndex}_${Date.now()}.ass`);
  writeBurmeseAssFile(assPath, adjustedSubtitles, aspectRatio, clipSpec.clipTitleBurmese, styleOptions);

  const outputPath = path.join(CLIPS_DIR, outputFilename);

  // Video source MUST be a real moving video stream (file or URL) - NEVER use still frame images or -loop 1
  let activeVideoPath = media.sourceVideoPath;
  if (!activeVideoPath || (!activeVideoPath.startsWith("http://") && !activeVideoPath.startsWith("https://") && !fs.existsSync(activeVideoPath))) {
    activeVideoPath = await ensureCinematicBaseVideo();
  }

  const durationLimit = media.videoDurationSec && media.videoDurationSec > 3 ? media.videoDurationSec : 30;
  const safeStart = Math.max(0, Math.min(clipSpec.startSec, Math.max(0, durationLimit - actualClipDur)));

  // Ultra-fast bokeh blur filter chain (180:320 downscale blur upscale is 100x faster than full 1080p CPU boxblur)
  // Applied to EVERY moving frame of the video
  let filterComplexChain = "";
  if (framingMode === "blur_bg") {
    filterComplexChain = [
      `[0:v]split=2[in_bg][in_fg]`,
      `[in_bg]scale=180:320:force_original_aspect_ratio=increase,boxblur=4:1,scale=${W}:${H},setsar=1[bg]`,
      `[in_fg]scale=${W}:${H}:force_original_aspect_ratio=decrease,setsar=1[fg]`,
      `[bg][fg]overlay=(W-w)/2:(H-h)/2[base]`,
      `[base]drawbox=x=0:y=ih*0.68:w=iw:h=ih*0.32:color=black@0.60:t=fill,drawbox=x=iw*0.08:y=ih*0.68:w=iw*0.84:h=2:color=0xD4AF37@0.85:t=fill,ass=${assPath}[vout]`,
    ].join(";");
  } else if (framingMode === "letterbox") {
    filterComplexChain = [
      `[0:v]scale=${W}:${H}:force_original_aspect_ratio=decrease,pad=${W}:${H}:(ow-iw)/2:(oh-ih)/2:black,setsar=1,drawbox=x=0:y=ih*0.68:w=iw:h=ih*0.32:color=black@0.60:t=fill,drawbox=x=iw*0.08:y=ih*0.68:w=iw*0.84:h=2:color=0xD4AF37@0.85:t=fill,ass=${assPath}[vout]`,
    ].join(";");
  } else {
    filterComplexChain = [
      `[0:v]scale=${W}:${H}:force_original_aspect_ratio=increase,crop=${W}:${H},setsar=1,drawbox=x=0:y=ih*0.68:w=iw:h=ih*0.32:color=black@0.60:t=fill,drawbox=x=iw*0.08:y=ih*0.68:w=iw*0.84:h=2:color=0xD4AF37@0.85:t=fill,ass=${assPath}[vout]`,
    ].join(";");
  }

  const wavPath = path.join(jobDir, `tts_${clipIndex}.wav`);
  let hasTts = false;
  if (audioMode === "voiceover" || audioMode === "mix") {
    hasTts = await generateNarrationWav(clipSpec.narrationBurmese, wavPath);
  }

  const ffmpegArgs: string[] = ["-y"];

  if (activeVideoPath.startsWith("http://") || activeVideoPath.startsWith("https://")) {
    ffmpegArgs.push(
      "-user_agent",
      "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
      "-reconnect",
      "1",
      "-reconnect_streamed",
      "1",
      "-reconnect_delay_max",
      "5"
    );
  }

  // Fast seeking BEFORE -i cuts the actual moving video stream and audio stream directly
  ffmpegArgs.push(
    "-ss",
    safeStart.toFixed(2),
    "-t",
    actualClipDur.toFixed(2),
    "-i",
    activeVideoPath
  );

  if (hasTts && fs.existsSync(wavPath)) {
    ffmpegArgs.push("-i", wavPath);
    if (audioMode === "mix" && media.hasAudio) {
      const mixFilter = `${filterComplexChain};[0:a]volume=0.35[orig_a];[1:a]volume=1.2[tts_a];[orig_a][tts_a]amix=inputs=2:duration=first[aout]`;
      ffmpegArgs.push("-filter_complex", mixFilter, "-map", "[vout]", "-map", "[aout]");
    } else {
      ffmpegArgs.push("-filter_complex", filterComplexChain, "-map", "[vout]", "-map", "1:a:0");
    }
  } else if (media.hasAudio) {
    ffmpegArgs.push("-filter_complex", filterComplexChain, "-map", "[vout]", "-map", "0:a:0?");
  } else {
    // Generate cinematic subtle ambient backing audio so every clip has rich audio
    ffmpegArgs.push(
      "-f",
      "lavfi",
      "-t",
      actualClipDur.toFixed(2),
      "-i",
      "aevalsrc=0.035*sin(2*PI*110*t)+0.02*sin(2*PI*164.81*t):s=24000",
      "-filter_complex",
      filterComplexChain,
      "-map",
      "[vout]",
      "-map",
      "1:a:0"
    );
  }

  ffmpegArgs.push(
    "-c:v",
    "libx264",
    "-preset",
    "ultrafast",
    "-tune",
    "fastdecode",
    "-threads",
    "0",
    "-crf",
    "23",
    "-pix_fmt",
    "yuv420p",
    "-c:a",
    "aac",
    "-b:a",
    "128k",
    "-movflags",
    "+faststart",
    outputPath
  );

  await execFileAsync("ffmpeg", ffmpegArgs, { timeout: 25000 });

  // Generate a dedicated high-resolution JPG poster snapshot from the rendered video
  const posterFilename = outputFilename.replace(/\.mp4$/, ".jpg");
  const posterPath = path.join(CLIPS_DIR, posterFilename);
  try {
    await execFileAsync("ffmpeg", [
      "-y",
      "-ss", "0.5",
      "-i", outputPath,
      "-frames:v", "1",
      "-q:v", "2",
      posterPath,
    ]);
  } catch {
    // Non-fatal
  }

  const stat = fs.statSync(outputPath);
  const fileSizeMb = `${Math.max(0.2, stat.size / (1024 * 1024)).toFixed(2)} MB`;

  let resLabel = "720×1280 (9:16)";
  if (aspectRatio === "16:9") resLabel = "1280×720 (16:9)";
  if (aspectRatio === "1:1") resLabel = "1080×1080 (1:1)";

  return {
    id: outputFilename.replace(/\.mp4$/, ""),
    index: clipIndex + 1,
    titleBurmese: clipSpec.clipTitleBurmese,
    summaryBurmese: clipSpec.clipSummaryBurmese,
    videoUrl: `/api/clips/${outputFilename}`,
    downloadUrl: `/api/clips/${outputFilename}?download=1`,
    posterUrl: `/api/clips/${posterFilename}`,
    filename: outputFilename,
    durationSec: Math.round(actualClipDur),
    aspectRatio,
    resolutionLabel: resLabel,
    fileSizeMb,
    audioMode,
    subtitles: adjustedSubtitles,
    styleOptions,
  };
}

