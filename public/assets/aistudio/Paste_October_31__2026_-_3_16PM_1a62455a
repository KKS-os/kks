        ? req.body.audioMode
        : "original";
    const clipDuration: number = Number(req.body?.durationSec) || 12;
    const framingMode: "blur_bg" | "crop_fill" | "letterbox" =
      req.body?.framingMode === "crop_fill" || req.body?.framingMode === "letterbox"
        ? req.body.framingMode
        : "blur_bg";
    const styleOptions: SubtitleStyleOptions = req.body?.styleOptions || {
      theme: "gold",
      fontSize: "md",
      position: "bottom",
    };

    if (!rawUrl) {
      res.status(400).json({ error: "ကျေးဇူးပြု၍ ဗီဒီယို Link တစ်ခု ထည့်သွင်းပေးပါ။" });
      return;
    }

    // Fast Cache Check (within 15 minutes) to prevent redundant encoding & avoid external rate limits
    const cacheKey = `${rawUrl}::${aspectRatio}::${audioMode}::${clipDuration}::${framingMode}::${styleOptions.theme}`;
    const cachedEntry = recapResultCache.get(cacheKey);
    if (cachedEntry && Date.now() - cachedEntry.timestamp < 15 * 60 * 1000) {
      const allFilesExist = cachedEntry.clips.every((c) =>
        fs.existsSync(path.join(CLIPS_DIR, c.filename))
      );
      if (allFilesExist) {
        res.json({
          sourceTitle: cachedEntry.sourceTitle,
          clips: cachedEntry.clips,
        });
        return;
      }
    }

    const jobId = `job_${Date.now()}_${crypto.randomBytes(3).toString("hex")}`;
    const jobDir = path.join(TMP_JOBS_DIR, jobId);
    fs.mkdirSync(jobDir, { recursive: true });

    try {
      const media = await extractSourceMedia(rawUrl, jobDir);
      const specs = await analyzeVideoWithGemini(media, clipDuration);
      const batchId = `${Date.now().toString(36)}_${crypto.randomBytes(2).toString("hex")}`;

      // Render Highlight Clip 1 immediately
      const outName1 = `KKS_Clip_${batchId}_01.mp4`;
      const clip1 = await renderClipToMp4({
        clipSpec: specs[0],
        clipIndex: 0,
        media,
        aspectRatio,
        audioMode,
        framingMode,
        styleOptions,
        jobDir,
        outputFilename: outName1,
      });

      // Render remaining clips in parallel with 6s timeout race
      const remainingPromises = specs.slice(1).map((spec, idx) => {
        const outName = `KKS_Clip_${batchId}_0${idx + 2}.mp4`;
        return renderClipToMp4({
          clipSpec: spec,
          clipIndex: idx + 1,
          media,
          aspectRatio,
          audioMode,
          framingMode,
          styleOptions,
          jobDir,
          outputFilename: outName,
        }).catch((err) => {
          console.error(`Clip ${idx + 2} render error:`, err);
          return null;
        });
      });

      const remainingResults = await Promise.race([
        Promise.all(remainingPromises),
        new Promise<null[]>((resolve) => setTimeout(() => resolve([]), 6000)),
      ]);

      const renderedClips: RenderedClipResult[] = [clip1];
      for (const res of remainingResults) {
        if (res) renderedClips.push(res);
      }

      // Store in memory cache for instant future serving
      recapResultCache.set(cacheKey, {
        sourceTitle: media.title,
        clips: renderedClips,
        timestamp: Date.now(),
      });

      res.json({
        sourceTitle: media.title,
        clips: renderedClips,
      });
    } catch (err: any) {
      console.error("Recap process error:", err);
      const isRate =
        err &&
        (err.status === 429 ||
          err.statusCode === 429 ||
          (typeof err.message === "string" &&
            (err.message.includes("Rate exceeded") ||
              err.message.includes("rate limit") ||
              err.message.includes("quota") ||
              err.message.includes("ResourceExhausted"))));

      if (isRate) {
        res.status(429).json({
          error:
            "ဆာဗာ တောင်းဆိုမှု အရေအတွက် ခေတ္တ ပြည့်နေပါသည် (Rate limit exceeded)။ စက္ကန့်အနည်းငယ် စောင့်ဆိုင်းပြီး ထပ်မံ ကြိုးစားပေးပါ။",
        });
        return;
      }

      const message =
        err instanceof Error
          ? err.message
          : "ဗီဒီယိုကို ဖြတ်တောက်ရာတွင် အခက်အခဲ ဖြစ်ပေါ်နေပါသည်။ Link ကို စစ်ဆေးပြီး ထပ်မံကြိုးစားပါ။";
      res.status(500).json({ error: message });
    } finally {
      try {
        fs.rmSync(jobDir, { recursive: true, force: true });
      } catch {
        // Ignore
      }
    }
  });

  if (process.env.NODE_ENV !== "production") {
    const { createServer: createViteServer } = await import("vite");
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.resolve(ROOT_DIR, "dist");
    app.use(express.static(distPath));
    app.get("*", (_req, res) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  // Global error handler: gracefully catch RangeNotSatisfiableError or uncaught errors
  app.use((err: any, _req: express.Request, res: express.Response, _next: express.NextFunction) => {
    if (
      err &&
      (err.name === "RangeNotSatisfiableError" ||
        err.status === 416 ||
        err.statusCode === 416 ||
        (typeof err.message === "string" && err.message.includes("Range Not Satisfiable")))
    ) {
      if (!res.headersSent) {
        res.status(416).setHeader("Content-Range", "bytes */*").end();
      }
      return;
    }
    console.error("Express unhandled error:", err);
    if (!res.headersSent) {
      const isRate =
        err &&
        (err.status === 429 ||
          err.statusCode === 429 ||
          (typeof err.message === "string" &&
            (err.message.includes("Rate exceeded") ||
              err.message.includes("rate limit") ||
              err.message.includes("quota"))));
      if (isRate) {
        res.status(429).json({
          error:
            "ဆာဗာ တောင်းဆိုမှု အရေအတွက် ခေတ္တ ပြည့်နေပါသည် (Rate limit exceeded)။ စက္ကန့်အနည်းငယ် စောင့်ဆိုင်းပြီး ထပ်မံ ကြိုးစားပေးပါ။",
        });
        return;
      }
      res.status(err.status || 500).json({ error: err.message || "Internal server error" });
    }
  });

  const server = app.listen(PORT, "0.0.0.0", () => {
    console.log(`KKS Recap AI (Gold Mode) server listening on http://0.0.0.0:${PORT}`);
  });
  server.keepAliveTimeout = 65000;
  server.headersTimeout = 66000;
  server.setTimeout(180000);
}

startServer();
