# GEMINI_API_KEY: Required for server-side Demo Mode fallback Gemini AI API calls.
# Users can also supply their own free key via Settings (x-gemini-api-key header).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Backend HTTP port (Render sets this automatically; defaults to 3000).
PORT=3000

# FRONTEND_URL: Allowed CORS origin(s) for split frontend hosting (e.g. https://your-app.vercel.app). Defaults to *.
FRONTEND_URL="*"

# VITE_API_BASE_URL: Optional backend base URL when frontend is deployed separately on Vercel (e.g. https://your-api.onrender.com).
VITE_API_BASE_URL=""

